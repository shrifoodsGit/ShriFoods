@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div id="top"></div>
<section class="hero">
    <div class="hero-overlay">
        <div class="hero-content">
            <h1 class="text-xxl-center">Shri Suchi Foods</h1>
            <h1>Pure. Fresh. Natural.</h1>
            <p>Premium Quality Grains & Atta for Every Home</p>
            <a href="#products" class="btn-primary">Explore Products</a>
        </div>
    </div>
</section>
<!----------------------------- Products --------------------------------------------->

<h2>Our Products </h2>
<div class="container-fluid">
    <section id="products" class="products-section">
        <div class="container-fluid">
            <h2 class="section-title">Our Premium Products</h2>

            @foreach (ShriFoods.Model.ProductModel listproduct in Model.listProductModel)
            {
                <br />
                <div class="card">
                    <div class="ride-row ride-card-header">
                        <h5 class="col-4">
                            <label>@listproduct.ProductName</label>
                        </h5>
                        <h5 class="col-4">
                        </h5>
                        <h5 class="col-4">
                        </h5>
                    </div>
                    <div class="row card-body">
                        <h6 class="col-6">
                            @if (!string.IsNullOrEmpty(Model.ImageBase64))
                            {
                                <img src="data:image/jpeg;base64,@Model.ImageBase64" alt="Database Image" width="200px" height="200px" />
                            }
                        </h6>
                        <h5 class="col-3"> Price: </h5>
                        <h5 class="col-3"><i class="bi bi-currency-rupee"></i>@listproduct.ProductPrice</h5>
                    </div>
                    <div class="ride-row ride-card-header">
                        <h5 class="col-4">
                            <a asp-page="/Product/Products" asp-route-id="@listproduct.ProductId">
                                <button type="submit" class="btn btn-primary">AddToCart</button>
                            </a>
                        </h5>
                        <h5 class="col-4"></h5>
                        <h5 class="col-4"></h5>
                    </div>
                </div>
            }


              
        </div>
    </section>
</div>


<section class="about-section">
    <div class="container about-content">
        <div class="about-text">
            <h2>Why Choose Shri Foods?</h2>
            <p>
                We deliver farm-fresh grains and premium quality flour directly to your kitchen.
                No preservatives. No compromise. Just purity and health.
            </p>
            <a href="#contact" class="btn-primary">Contact Us</a>
        </div>
    </div>
</section>

<section id="contact" class="contact-section">
    <div class="container text-center">
        <h2>Get In Touch</h2>
        <p>Call: +91 8374499001</p>
        <p>Email: shripavanb@shrifoods.in</p>
    </div>
</section>


