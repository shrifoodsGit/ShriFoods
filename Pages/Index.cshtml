@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<link href="~/css/site.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
<div id="top"></div>
<section class="hero">
    <div class="hero-overlay">
        <div class="hero-content">
            <h1 class="text-xxl-center">Shri Suchi Foods</h1>
            <h1>Pure. Fresh. Natural.</h1>
            <p>Premium Quality Grains & Atta for Every Home</p>
            <a href="#products" class="btn-primary">Explore Products</a>
        </div>
    </div>
</section>
<!----------------------------- Products --------------------------------------------->

<h2>Our Products </h2>
<section id="products" class="products-section">
        <div class="container">
            <h2 class="section-title">Our Premium Products</h2>
        <div class="row">
            <div class="products-grid">
            @foreach (ShriFoods.Model.ProductModel listproduct in Model.listProductModel)
            {
            <div class="product-card">
        
                                @if (listproduct.ProductName == "Multigrain")
                                {
                                    <div id="dynamicCarousel" class="carousel" data-bs-ride="carousel" >
                                        <!-- Indicators -->
                                        <div class="carousel-indicators">
                                            @for (int i = 0; i < Model.AttaImageUrls.Count; i++)
                                            {
                                                <button type="button" data-bs-target="#dynamicCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                                            }
                                        </div>

                                        <!-- Inner Items -->
                                        <div class="carousel-inner">
                                            @for (int i = 0; i < Model.AttaImageUrls.Count; i++)
                                            {
                                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                                    <img src="@Model.AttaImageUrls[i]" class="d-block" width="250px" height="250px" />
                                                </div>
                                            }
                                        </div>

                                        <!-- Controls -->
                                        <button class="carousel-control-prev" type="button" data-bs-target="#dynamicCarousel" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon"></span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#dynamicCarousel" data-bs-slide="next">
                                            <span class="carousel-control-next-icon"></span>
                                        </button>
                                    </div>
                                }
                                @*  @if (listproduct.ProductName == "Multigrain")
                            {
                                @foreach (var imageUrl in Model.AttaImageUrls)
                                {
                                    <img src="@imageUrl" alt="Gallery Image" style="width: 200px; margin: 10px;" />
                                }
                            } *@else
                                {
                                    // Convert byte array to Base64 string
                                    var ImageBase64 = Convert.ToBase64String(listproduct.ProductImage);
                         
                                    @if (!string.IsNullOrEmpty(ImageBase64))
                                    {
                                        <img src="data:image/jpeg;base64,@ImageBase64" alt="Database Image" width="200px" height="200px" />
                                    }
                                }

                        <h3 >
                            <label style="font-weight:bold">@listproduct.ProductName</label>
                        </h3>
                            <h5 >
                                @listproduct.ProductDescription               
                            </h5>
                        <h5 >
                            <i class="bi bi-currency-rupee"></i>@listproduct.ProductPrice/kg </h5>
             
          
                            <a asp-page="/Product/Products" asp-route-id="@listproduct.ProductId">
                                <button type="submit" class="btn btn-primary">AddToCart</button>
                            </a>
                    
                   
                    </div>
            <br />
            }
            </div>
        </div>
       </div>
    </section>

<section class="about-section">
    <div class="container about-content">
        <div class="about-text">
            <h2>Why Choose Shri Foods?</h2>
            <p>
                We deliver farm-fresh grains and premium quality flour directly to your kitchen.
                No preservatives. No compromise. Just purity and health.
            </p>
            <a href="#contact" class="btn-primary">Contact Us</a>
        </div>
    </div>
</section>

<section id="contact" class="contact-section">
    <div class="container text-center">
        <h2>Get In Touch</h2>
        <p>Call: +91 8374499001</p>
        <p>Email: shripavanb@shrifoods.in</p>
    </div>
</section>


