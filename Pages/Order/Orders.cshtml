@page "{id:int}"
@model ShriFoods.Pages.Order.OrdersModel
@{
    ViewData["Title"] = "Order Summary";
}
<div class="container-fluid">
    <h2>Order Placed Successfully</h2>



    <div class="container mt-5 mb-5">

        @if (Model.Order != null)
        {
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <div class="card-header bg-dark text-white p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h2 class="mb-1">Order Summary</h2>
                        <p class="mb-0 opacity-75">
                            Order ID: #@Model.Order.OrderId
                        </p>
                    </div>

                    <a asp-page-handler="DownloadPdf"
                           asp-route-id="@Model.Order.OrderId"
                           class="btn btn-warning btn-lg rounded-pill px-4">
                        Download PDF
                    </a>
                </div>

                <div class="card-body p-4 p-md-5">
    <!-- Customer Details -->
    <div class="row mb-5">

        <div class="col-md-6 mb-4 mb-md-0">
            <h5 class="fw-bold mb-3">Customer Details</h5>

            <p class="mb-2">
                <strong>Name:</strong>
              @*   @Model.Order.CustomerName *@
            </p>

            <p class="mb-2">
                <strong>Phone:</strong>
                @Model.Order.PhoneNumber
            </p>

            <p class="mb-2">
                <strong>Email:</strong>
          @*       @Model.Order.Email *@
            </p>
        </div>

        <div class="col-md-6 text-md-end">
            <h5 class="fw-bold mb-3">Order Information</h5>

            <p class="mb-2">
                <strong>Date:</strong>
                @Model.Order.OrderedDate.ToString("dd MMM yyyy hh:mm tt")
            </p>

            <p class="mb-2">
                <strong>Status:</strong>

                <span class="badge bg-success px-3 py-2">
                    @Model.Order.OrderStatus
                </span>
            </p>
        </div>
    </div>
    <!-- Products -->
    <div class="table-responsive">

        <table class="table table-bordered align-middle table-hover">

            <thead class="table-dark">
                <tr>
                    <th>Item</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model.Order.OrderDetails)
                {
                    <tr>
                        <td>@item.Product?.ProductName</td>

                        <td class="text-center">
                            @item.Quantity
                        </td>

                        <td class="text-end">
                            ₹@item.UnitPrice.ToString("N2")
                        </td>

                        <td class="text-end fw-semibold">
                            ₹@((item.Quantity * item.UnitPrice).ToString("N2"))
                        </td>
                    </tr>
                }

            </tbody>

        </table>
</div>

<!-- Totals -->
<div class="row mt-4 justify-content-end">

    <div class="col-md-5 col-lg-4">

        <div class="card bg-light border-0 shadow-sm rounded-4">

            <div class="card-body">

                <div class="d-flex justify-content-between fs-5 fw-bold">
                    <span>Total Amount</span>
                    <span>₹@Model.Order.TotalAmount.ToString("N2")</span>
                </div>

            </div>

        </div>

    </div>

</div>

</div>
</div>
}
else
{
<div class="alert alert-danger shadow-sm rounded-4 p-4">
    <h4 class="mb-2">Order not found</h4>
    <p class="mb-0">The requested order could not be loaded.</p>
</div>
}

</div>

</div>