<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShriFoods</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
     <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index"><img src="~/img/logo/NewLogo_Small_1.png" width="150" height="100" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="./Product/Products">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="./Contact">ContactUs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="./JoinUs">JoinUs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>

                    </ul>
                </div>
                <div class="nav-contact">
                    <a href="tel:+918374499001" class="call-btn">📞 Call Now</a>
                </div>

                <div class="menu-toggle" onclick="toggleMenu()">☰</div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <!-- FOOTER -->
    <footer class="footer">
        <div class="container footer-grid">
            <div>
                <h3>Shri Foods</h3>
                <p>Pure • Fresh • Natural</p>
                <p>Premium quality grains & flour for healthy living.</p>
            </div>
            <div>
                <h4>Quick Links</h4>
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index1">Home</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Products">Products</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="AboutUs">AboutUs</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Contact">ContactUs</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="JoinUs">JoinUs</a></li>
                </ul>
            </div>

            <div>
                <h4>Contact</h4>
                <p>📞 +91 8374499001</p>
                <p>✉ shripavanb@shrifoods.in</p>
            </div>
            <div class="footer-bottom">
                © @DateTime.Now.Year Shri Foods. All Rights Reserved-Powered by <a href="https://shriaitech.in" target="_blank">Shri AI tech</a>.
            </div>
        </div>
    </footer>
    <!-- WhatsApp Floating Button -->
    <a href="https://wa.me/918374499001" class="whatsapp-float" target="_blank">
        💬
    </a>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
   @*  <script src="~/js/site.js" asp-append-version="true"></script> *@

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>