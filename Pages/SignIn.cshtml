@page
@model ShriFoods.Pages.SignInModel
    <link href="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
    <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <link href="~/css/signin.css" rel="stylesheet" />

    <div>
        <h3>SignIn</h3>
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6 login-form-1">
                    <h3>Login</h3>
                    <form method="post">
                    @if (ViewData["Message"] != null)
                    {
                        <div class="alert alert-info">@ViewData["Message"]</div>
                    }
                        <div class="form-group">
                            <input type="text" class="form-control" placeholder="Email/Phone No *" value="" id="InputEmail" name="InputEmail" />
                        </div>
                        <div class="form-group">
                            <input type="password" class="form-control" placeholder="Your Password *" value="" id="InputPswd" name="InputPswd" />
                        </div>
                        <div class="form-group">
                            <input type="submit" class="btnSubmit" value="Login" />
                        </div>
                        <div class="form-group">
                            <a href="#" class="ForgetPwd">Forget Password?</a>
                        </div><p>Or</p>
                        <br />
                        <div class="form-group">
                            <a href="/SignUp" class=""><input type="button" class="btnSubmit" value="SignUp" /></a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

@if (ViewData["Message"] != null)
{
    <script type="text/javascript">
        document.onload = function () {
        alert("@ViewData["Message"]");
        };
    </script>
}